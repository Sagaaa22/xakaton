# Grand Mobile Support Copilot Configuration
# Copy to .env to customize settings. Do NOT commit secret keys.

# Paths to knowledge base and taxonomy
RULES_PATH=rules.json
TAXONOMY_PATH=taxonomy.json
TRAIN_DATA_PATH=tickets_train.jsonl.gz
VALID_DATA_PATH=tickets_valid.jsonl
SYNTHETIC_TRAIN_PATH=data/synthetic_tickets_train.jsonl.gz
SYNTHETIC_VALID_PATH=data/synthetic_tickets_valid.jsonl
MODEL_WEIGHTS_PATH=models/classifier_weights.json

# Optional LLM Provider Configuration (OpenAI-compatible API)
# Leave LLM_API_KEY empty to use fast local deterministic rule-grounded generation ($0.00/ticket, <10ms latency)
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=3.5
LLM_INPUT_COST_PER_1K=0.00015
LLM_OUTPUT_COST_PER_1K=0.00060

# Telegram Admin Notifications Configuration
# Provide TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID to send real Telegram messages via Bot API.
# When empty, notifications are queued in the local outbox and visible in the Dashboard.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional JSON or comma-separated mapping of admin_id:telegram_chat_id (e.g. junior_1:123456,senior_1:789012)
TELEGRAM_ADMIN_IDS=
TELEGRAM_REMINDER_MINUTES=15
DASHBOARD_BASE_URL=http://127.0.0.1:8000

# Grand Mobile Game Server API Integration (Optional)
# Honest disclosure: if GRAND_MOBILE_API_URL / KEY are not set, the service operates in local/demo history mode.
GRAND_MOBILE_API_ENABLED=false
GRAND_MOBILE_API_URL=
GRAND_MOBILE_API_KEY=
GRAND_MOBILE_API_TIMEOUT=3.0

# Evidence Analyzer & OCR Configuration
MAX_EVIDENCE_SIZE_MB=25
OCR_ENABLED=true
TESSERACT_CMD=

# Server Configuration
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
