# Grand Mobile Support Copilot — Environment Configuration Template
# Copy to .env and customize as needed

# Built-in Local Context-Aware RAG LLM (works without external API keys)
LLM_ENABLED=true
LLM_MODEL=local-grand-rag-v1
LLM_API_KEY=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=3.5

# Google Gemini API (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your_gemini_api_key_here

# Groq API
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_groq_api_key_here

# OpenAI API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key_here
